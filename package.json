{
   "name": "triangle",
   "version": "0.1.0",
   "private": true,
   "type": "module",
   "packageManager": "bun@1.3.14",
   "scripts": {
      "dev": "convex dev --env-file .env.local --start 'bun run dev:web'",
      "dev:web": "vite dev",
      "build": "vite build",
      "start": "bun .output/server/index.mjs",
      "start:docker": "bun .output/server/index.mjs",
      "mcp": "bun --env-file=.env.local mcp/server.ts",
      "convex:dev": "convex dev --env-file .env.local",
      "convex:push": "convex dev --once --env-file .env.local",
      "secrets:import": "secrets-sync import",
      "secrets:check": "secrets-sync import --check",
      "secrets:audit": "secrets-sync audit dev",
      "secrets:export": "secrets-sync export dev",
      "secrets:publish": "secrets-sync export dev --apply",
      "deploy:dry-run": "deploy triangle --dry-run --yes",
      "deploy:sync-only": "deploy triangle --sync-only",
      "deploy": "deploy triangle --with-convex",
      "lint": "eslint .",
      "format": "prettier --write .",
      "typecheck": "tsc --noEmit",
      "prepare": "husky"
   },
   "dependencies": {
      "@convex-dev/react-query": "^0.1.0",
      "@fontsource/geist-mono": "^5.3.0",
      "@fontsource/inter": "^5.3.0",
      "@modelcontextprotocol/sdk": "^1.32.1",
      "@radix-ui/react-alert-dialog": "^1.1.24",
      "@radix-ui/react-avatar": "^1.2.7",
      "@radix-ui/react-checkbox": "^1.3.12",
      "@radix-ui/react-collapsible": "^1.1.21",
      "@radix-ui/react-context-menu": "^2.3.8",
      "@radix-ui/react-dialog": "^1.2.0",
      "@radix-ui/react-dropdown-menu": "^2.1.25",
      "@radix-ui/react-label": "^2.1.16",
      "@radix-ui/react-popover": "^1.2.0",
      "@radix-ui/react-progress": "^1.1.17",
      "@radix-ui/react-select": "^2.3.8",
      "@radix-ui/react-separator": "^1.1.16",
      "@radix-ui/react-slot": "^1.4.0",
      "@radix-ui/react-switch": "^1.3.8",
      "@radix-ui/react-tabs": "^1.1.22",
      "@radix-ui/react-toggle": "^1.1.19",
      "@radix-ui/react-tooltip": "^1.3.0",
      "@remixicon/react": "^4.9.0",
      "@tanstack/react-query": "^5.104.1",
      "@tanstack/react-router": "^1.170.41",
      "@tanstack/react-router-devtools": "^1.167.2",
      "@tanstack/react-router-ssr-query": "^1.167.3",
      "@tanstack/react-start": "^1.168.60",
      "@vitejs/plugin-react": "^6.1.2",
      "class-variance-authority": "^0.7.1",
      "clsx": "^2.1.1",
      "cmdk": "1.0.0",
      "convex": "^1.42.1",
      "date-fns": "^4.4.0",
      "highlight.js": "^11.12.0",
      "lucide-react": "^0.476.0",
      "motion": "^12.43.0",
      "next-themes": "^0.4.6",
      "nitro": "3.0.260311-beta",
      "react": "^19.3.0",
      "react-day-picker": "8.10.1",
      "react-dnd": "^16.0.1",
      "react-dnd-html5-backend": "^16.0.1",
      "react-dom": "^19.3.0",
      "react-hook-form": "^7.89.0",
      "react-resizable-panels": "^3.0.6",
      "sonner": "^2.0.8",
      "tailwind-merge": "^3.7.0",
      "tailwindcss-animate": "^1.0.7",
      "uuid": "^11.1.1",
      "vite": "^8.3.4",
      "zod": "^4.6.5",
      "zustand": "^5.0.15"
   },
   "devDependencies": {
      "@eslint/js": "^9.39.5",
      "@tailwindcss/vite": "^4.3.3",
      "@types/node": "^20.19.43",
      "@types/react": "^19.3.0",
      "@types/react-dom": "^19.3.0",
      "eslint": "^9.39.5",
      "eslint-config-prettier": "^10.1.8",
      "eslint-plugin-prettier": "^5.5.6",
      "husky": "^9.1.7",
      "lint-staged": "^15.5.2",
      "prettier": "^3.9.9",
      "tailwindcss": "^4.3.3",
      "typescript": "^5.9.3",
      "typescript-eslint": "^8.71.1"
   },
   "overrides": {
      "proxy-addr": "^2.0.8",
      "hono": "^4.12.34",
      "fast-uri": "^3.1.8",
      "js-yaml": "^4.3.2",
      "source-map-js": "^1.2.2",
      "qs": "^6.16.0",
      "ip-address": "^10.7.3"
   }
